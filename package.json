{
  "dependencies": {
    "bootstrap": "^5.3.5"
  },
  "devDependencies": {
    "sass": "^1.86.3",
    "browser-sync": "^3.0.2"
  },
  "scripts": {
    "clean": "rm -rf _site",
    "build:bootstrap": "sass node_modules/bootstrap/scss/bootstrap.scss assets/vendor/bootstrap/css/bootstrap.css",
    "build": "npm run clean && npm run build:bootstrap",
    "dev": "browser-sync start --server --files '**/*.html, **/*.css, **/*.js, **/*.json'"
  }
}